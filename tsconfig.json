{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "allowJs": true,
    "rootDir": "./",
    "types": ["k6"],
    "lib": ["esnext", "dom"]
  },
  "exclude": ["node_modules", "grafana", "results"]
}
