{
  "name": "k6-performance",
  "version": "1.0.0",
  "description": "k6 + TypeScript performance tests",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lint:all": "eslint . --fix && prettier --write .",
    "test:login:smoke": "k6 run -e ENV=exercise -e LOAD=smoke tests/scenarios/loginScenario.ts",
    "test:workflow:smoke": "k6 run -e ENV=exercise -e LOAD=smoke tests/scenarios/workflowExecutionScenario.ts",
    "test:workflow:burst": "k6 run -e ENV=exercise -e LOAD=burst -e THRESHOLD=burst tests/scenarios/workflowExecutionScenario.ts",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:login:smoke": "docker exec -it k6 k6 run -e ENV=exercise -e LOAD=smoke tests/scenarios/loginScenario.ts",
    "docker:workflow:smoke": "docker exec -it k6 k6 run -e ENV=exercise -e LOAD=smoke tests/scenarios/workflowExecutionScenario.ts",
    "docker:workflow:burst": "docker exec -it k6 k6 run -e ENV=exercise -e LOAD=burst -e THRESHOLD=burst tests/scenarios/workflowExecutionScenario.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/k6": "^1.3.0",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.7",
    "jiti": "^2.7.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.72.0"
  }
}
